DATABASE_URL="postgresql://prismadoc:prismadoc@localhost:5434/prismadoc?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Demo accounts on the login page. Shown when NODE_ENV is not production.
# Set true to show them in production, or false to hide them in development.
# SHOW_DEMO_ACCOUNTS="false"

# Workplace login is OpenID Connect. Leave a block empty to hide its button.
# PrismaDoc keeps the role. An email must already be invited or the sign-in is refused.
# SAML is not used: Entra, Google Workspace, and AD FS all speak OIDC.
# Raw LDAP is not used: the app must not collect Active Directory passwords.

# Microsoft Entra ID (single tenant). Redirect: {NEXTAUTH_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Google Workspace. hd is checked again on the ID token, so personal Gmail is refused.
# Redirect: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_DOMAIN=""

# Local Active Directory through an OIDC issuer (AD FS, or a broker in front of LDAP).
# Redirect: {NEXTAUTH_URL}/api/auth/callback/oidc
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_LABEL="Active Directory"

# Review deadline. A daily job at 08:00 Asia/Jakarta reminds the primary approver,
# or delegates the decision to their backup approver.
# Vercel Cron calls GET /api/cron/review-escalation with Authorization: Bearer $CRON_SECRET.
# Local and self-hosted servers use the same schedule via node-cron.
REVIEW_SLA_DAYS="3"
REVIEW_CRON="0 1 * * *"
CRON_SECRET=""

# Private file access. Objects stay off the public web (local uploads/, or a private
# MinIO/S3 bucket read only by the server). Clients receive a signed URL that expires
# quickly and only works for the employee who opened the page.
FILE_URL_TTL_SECONDS="300"
FILE_URL_SECRET=""

# Policy detail summary and AI search. Pengaturan overrides this with Gemini, Groq, OpenAI, or Ollama.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional SMTP fallback. A saved mailbox in Pengaturan overrides these.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
