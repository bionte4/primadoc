generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  REVIEWER
  APPROVER
  ADMIN
}

enum PolicyStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

/// Decision recorded on an approval step.
enum WorkflowStepStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PolicyType {
  POLICY
  PROCEDURE
  TECHNICAL_GUIDE
}

enum Department {
  CORP
  HR
  IT
  FIN
  OPS
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  /// Object id from Microsoft Entra ID. Empty until that user signs in with Microsoft.
  entraId   String?  @unique
  /// Last workplace IdP: azure-ad, google, or oidc (Active Directory via OpenID Connect).
  authProvider String?
  /// Subject from that IdP (`sub`, or the Entra object id).
  externalId   String?
  role      Role     @default(STAFF)
  /// Approver who receives this person's queue after the review deadline.
  backupApproverId String?
  backupApprover   User?    @relation("ApproverBackup", fields: [backupApproverId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies          Policy[]           @relation("PolicyAuthor")
  primaryReviews    Policy[]           @relation("PrimaryApprover")
  delegatedReviews  Policy[]           @relation("DelegatedApprover")
  coveringFor       User[]             @relation("ApproverBackup")
  workflowApprovals WorkflowApproval[]
  auditLogs         AuditLog[]
  attestations      Attestation[]
  notifications     Notification[]

  @@unique([authProvider, externalId])
}

model Policy {
  id             String       @id @default(cuid())
  title          String
  documentNumber String
  category       String
  description    String       @db.Text
  fileUrl        String?
  fileName       String?
  /// Plain text extracted from the PDF or Word file, used by full-text search.
  contentText    String?      @db.Text
  /// Filled by a database trigger. Includes title, number, category, description, and file text.
  searchVector   Unsupported("tsvector")?
  version        String       @default("1.0")
  versionGroupId String
  isCurrent      Boolean      @default(true)
  status         PolicyStatus @default(DRAFT)
  type           PolicyType   @default(POLICY)
  department     Department   @default(CORP)
  /// Row id of the parent kebijakan or prosedur. Empty for a kebijakan.
  parentId       String?
  parent         Policy?      @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Policy[]     @relation("DocumentHierarchy")
  /// Set when the parent document is archived and this child should be checked.
  needsReview    Boolean      @default(false)
  reviewStartedAt DateTime?
  remindedAt      DateTime?
  escalatedAt     DateTime?
  primaryApproverId   String?
  primaryApprover     User?        @relation("PrimaryApprover", fields: [primaryApproverId], references: [id], onDelete: SetNull)
  delegatedApproverId String?
  delegatedApprover   User?        @relation("DelegatedApprover", fields: [delegatedApproverId], references: [id], onDelete: SetNull)
  authorId       String
  author         User         @relation("PolicyAuthor", fields: [authorId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  approvals    WorkflowApproval[]
  auditLogs    AuditLog[]
  attestations Attestation[]
  notifications Notification[]

  @@unique([documentNumber, version])
  @@index([status])
  @@index([authorId])
  @@index([versionGroupId])
  @@index([isCurrent])
  @@index([searchVector], type: Gin)
  @@index([type])
  @@index([department])
  @@index([parentId])
  @@index([status, reviewStartedAt])
}

model WorkflowApproval {
  id         String             @id @default(cuid())
  policyId   String
  policy     Policy             @relation(fields: [policyId], references: [id], onDelete: Cascade)
  approverId String
  approver   User               @relation(fields: [approverId], references: [id])
  status     WorkflowStepStatus
  notes      String?            @db.Text
  stepOrder  Int
  createdAt  DateTime           @default(now())

  @@index([policyId])
}

model Attestation {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyId String
  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([userId, policyId])
  @@index([policyId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyId  String?
  policy    Policy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  title     String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  policyId  String?
  policy    Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())

  @@index([policyId])
  @@index([userId])
}
